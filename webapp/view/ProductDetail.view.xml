<mvc:View
    controllerName="com.alfa.products.list.controller.ProductDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.uxap"
    xmlns:m="sap.m"
    xmlns:f="sap.f"
    xmlns:form="sap.ui.layout.form"
>
    <ObjectPageLayout>
        <headerTitle>
            <ObjectPageDynamicHeaderTitle>
                <expandedHeading>
                    <m:Title text="{ProductName}" />
                </expandedHeading>

                <navigationActions>
                    <m:OverflowToolbarButton icon="sap-icon://full-screen" />
                    <m:OverflowToolbarButton icon="sap-icon://decline" />
                </navigationActions>

                <actions>
                    <m:Button text="Edit" />
                    <m:Button text="Deletar" />
                    <m:Button text="Copiar" />
                </actions>
            </ObjectPageDynamicHeaderTitle>
        </headerTitle>

        <headerContent>
            <m:HBox>
                <m:VBox class="sapUiTinyMarginEnd">
                    <m:Avatar
                        displaySize="L"
                        displayShape="Square"
                    />
                </m:VBox>

                <m:VBox class="sapUiTinyMarginEnd">
                    <m:Label text="Categoria" />
                    <m:Text text="{Category/CategoryName}" />
                </m:VBox>

                <m:VBox class="sapUiTinyMarginEnd">
                    <m:Label text="Quantidade por unidade" />
                    <m:Text text="{QuantityPerUnit}" />
                </m:VBox>

                <m:VBox class="sapUiTinyMarginEnd">
                    <m:Label text="Preço" />
                    <m:ObjectNumber
                        class="sapUiSmallMarginBottom"
                        number="{
                            parts: [
                                {path:'UnitPrice'},
                                {value: 'BRL'}
                            ],
                            type:'sap.ui.model.type.Currency',
                            formatOptions: {showMeasure: false}
                        }"
                        unit="BRL"
                    />
                </m:VBox>
            </m:HBox>
        </headerContent>

        <sections>
            <ObjectPageSection title="Fornecedor">
                <subSections>
                    <ObjectPageSubSection>
                        <blocks>
                            <form:SimpleForm>
                                <form:content>
                                    <m:Label text="Nome da empresa" />
                                    <m:Text text="{Supplier/CompanyName}" />

                                    <m:Label text="Vendedor" />
                                    <m:Text text="{Supplier/ContactName}" />

                                    <m:Label text="Endereço" />
                                    <m:Text text="{Supplier/Address}" />
                                </form:content>
                            </form:SimpleForm>
                        </blocks>
                    </ObjectPageSubSection>
                </subSections>
            </ObjectPageSection>
            <ObjectPageSection title="Pedidos">
                <subSections>
                    <ObjectPageSubSection>
                        <blocks>
                            <m:Table
                                growing="true"
                                growingThreshold="5"
                                items="{Order_Details}"
                            >
                                <m:columns>
                                    <m:Column />
                                </m:columns>

                                <m:items>
                                    <m:ColumnListItem>
                                        <m:cells>
                                            <m:ObjectIdentifier
                                                text="{OrderID}"
                                            />
                                        </m:cells>
                                    </m:ColumnListItem>
                                </m:items>
                            </m:Table>
                        </blocks>
                    </ObjectPageSubSection>
                </subSections>
            </ObjectPageSection>
        </sections>
    </ObjectPageLayout>

    <!-- <Page
        id="productDetail"
        title="{i18n>titleProductDetail} - {ProductName}"
        showNavButton="true"
        navButtonPress="navBack"
    /> -->
</mvc:View>
