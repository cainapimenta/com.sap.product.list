<mvc:View
    controllerName="com.alfa.products.list.controller.Products"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:f="sap.f"
>
    <f:DynamicPage id="product">
        <!-- DynamicPage Title-->
        <f:title>
            <f:DynamicPageTitle>
                <!-- Title -->
                <f:heading>
                    <Title text="{i18n>title}" />
                </f:heading>

                <!-- SubTitle -->
                <f:expandedContent>
                    <Text text="Lista de produtos atualizada" />
                </f:expandedContent>

                <f:snappedContent>
                    <Text text="Lista de produtos atualizada" />
                </f:snappedContent>

                <f:navigationActions>
                    <Button
                        icon="sap-icon://settings"
                        type="Transparent"
                    />
                    <Button
                        icon="sap-icon://full-screen"
                        type="Transparent"
                    />
                </f:navigationActions>
            </f:DynamicPageTitle>
        </f:title>

        <!-- Header -->
        <f:header>
            <f:DynamicPageHeader>
                <HBox>
                    <VBox class="sapUiMediumMarginEnd">
                        <ObjectAttribute
                            title="Planta"
                            text="São Paulo"
                        />
                        <ObjectAttribute
                            title="Capacidade"
                            text="100m²"
                        />
                        <ObjectAttribute
                            title="Vagas"
                            text="18"
                        />
                    </VBox>

                    <VBox>
                        <ObjectAttribute title="Categoria mais vendidada" />
                        <ObjectStatus
                            text="Beverages"
                            state="Information"
                        />
                    </VBox>
                </HBox>
            </f:DynamicPageHeader>
        </f:header>

        <!-- Conteudo -->
        <f:content>
            <VBox>
                <!-- OverflowToolbar para filtar -->
                <OverflowToolbar class="sapFDynamicPageAlingContent">
                    <ToolbarSpacer />

                    <SearchField
                        width="17.5rem"
                        liveChange=".onSearch"
                    />

                    <OverflowToolbarButton
                        icon="sap-icon://add"
                        type="Transparent"
                    />

                    <OverflowToolbarButton
                        icon="sap-icon://sort"
                        type="Transparent"
                    />
                </OverflowToolbar>

                <!-- Table de itens -->
                <Table
                    id="productsTableId"
                    class="sapFDynamicPageAlingContent"
                    width="auto"
                    growing="true"
                    growingThreshold="10"
                    items="{
                        path:'/Products',
                        parameters: {
                            expand: 'Category'
                        },
                        sorter: [
                            {
                                path: 'Category/CategoryName',
                                descending: false,
                                group: true
                            },
                            {
                                path: 'ProductName'
                            }
                        ]
                    }"
                >
                    <columns>
                        <Column width="12rem">
                            <Text text="Descrição" />
                        </Column>

                        <Column
                            hAlign="End"
                            vAlign="Middle"
                        >
                            <Text text="Price" />
                        </Column>
                    </columns>

                    <items>
                        <ColumnListItem
                            type="Navigation"
                            press=".onPressListItem"
                        >
                            <cells>
                                <ObjectIdentifier
                                    title="{ProductID} - {ProductName}"
                                    text="{QuantityPerUnit}"
                                />
                                <ObjectNumber
                                    class="sapUiSmallMarginBottom"
                                    number="{
                                        parts: [{path:'UnitPrice'},{value: 'BRL'}],
                                        type:'sap.ui.model.type.Currency',
                                        formatOptions: {showMeasure: false}
                                    }"
                                    unit="BRL"
                                    state="{
                                        path: 'UnitPrice',
                                        formatter: '.formatter.priceStatus'
                                    }"
                                />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </f:content>

