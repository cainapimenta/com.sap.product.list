<mvc:View
    controllerName="com.alfa.products.list.controller.Products"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
>
    <Page
        id="page"
        title="{i18n>title}"
    >
        <List
            headerText="Products"
            headerLevel="H2"
            items="{ 
                path: 'products>/'
            }"
            id="productListId"
        >
            <StandardListItem
                type="Active"
                title="{products>ProductName}"
                counter="{products>UnitsInStock}"
                press="onPressListItem"
            />

            <!-- <StandardListItem
                type="Active"
                title="Banana"
                counter="10"
                press="onPressListItem"
            />
            <StandardListItem
                title="Maçã"
                counter="1"
            /> -->
            
        </List>
    </Page>
</mvc:View>
