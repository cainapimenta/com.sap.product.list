<mvc:View
    controllerName="com.alfa.products.list.controller.Products"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
>
    <Page
        id="page"
        title="{i18n>title}"
    >
        <List
            headerText="Products"
            headerLevel="H2"
            id="productListId"
            growing="true"
            growingScrollToLoad="true"
            items="{ 
                path: '/Products',
                parameters: {
                    expand: 'Category'
                },
                sorter: [
                    {
                        path: 'Category/CategoryName',
                        descending: false,
                        group: true
                    },
                    {
                        path: 'ProductName'
                    }
                ]
            }"
        >
            <headerToolbar>
                <OverflowToolbar>
                    <Title
                        text="Products"
                        level="H2"
                    />

                    <ToolbarSpacer />

                    <SearchField
                        width="40rem"
                        liveChange="onSearch"
                    />
                </OverflowToolbar>
            </headerToolbar>
            <items>
                <StandardListItem
                    type="Active"
                    title="{ProductName}"
                    counter="{UnitsInStock}"
                    press="onPressListItem"
                />
            </items>
        </List>
    </Page>
</mvc:View>
