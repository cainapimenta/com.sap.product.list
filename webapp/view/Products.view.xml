<mvc:View
    controllerName="com.alfa.products.list.controller.Products"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
>
    <Page
        id="product"
        title="{i18n>title}"
    >
        <List
            headerText="Products"
            headerLevel="H2"
            id="productListId"
            growing="true"
            growingScrollToLoad="true"
            items="{ 
                path: '/Products',
                parameters: {
                    expand: 'Category'
                },
                sorter: [
                    {
                        path: 'Category/CategoryName',
                        descending: false,
                        group: true
                    },
                    {
                        path: 'ProductName'
                    }
                ]
            }"
        >
            <headerToolbar>
                <OverflowToolbar>
                    <Title
                        text="Products"
                        level="H2"
                    />

                    <ToolbarSpacer />

                    <SearchField
                        width="40rem"
                        liveChange="onSearch"
                    />
                </OverflowToolbar>
            </headerToolbar>
            <items>
                <CustomListItem type="Navigation" press="onPressListItem">
                    <HBox justifyContent="SpaceBetween">
                        <HBox>
                            <core:Icon
                                src="sap-icon://product"
                                size="2rem"
                                class="sapUiSmallMarginBegin sapUiSmallMarginTopBottom"
                            />
                            <VBox
                                class="sapUiSmallMarginBegin sapUiSmallMarginTopBottom"
                            >
                                <Title text="{ProductID} - {ProductName}" />
                                <ObjectNumber
                                    class="sapUiSmallMarginBottom"
                                    inverted="true"
                                    number="{
                                        parts: [{path:'UnitPrice'},{value: 'BRL'}],
                                        type:'sap.ui.model.type.Currency',
                                        formatOptions: {showMeasure: true}
                                    }"
                                    state="{
                                        path: 'UnitPrice',
                                        formatter: '.formatter.priceStatus'
                                    }"
                                />
                            </VBox>
                        </HBox>

                        <VBox class="sapUiSmallMargin">
                            <Text text='{UnitsInStock} un' visible="{= !!${UnitsInStock}}" class="custom"></Text>
                            <ObjectStatus 
                                text="Fora de estoque"
                                active="false"
                                inverted="true"
                                state="Indication12"
                                icon="sap-icon://error"
                                visible="{= !${UnitsInStock}}"
                            />
                        </VBox>
                    </HBox>
                </CustomListItem>

                <!-- <StandardListItem
                    type="Active"
                    title="{
                        parts: ['ProductName', 'UnitPrice'],
                        formatter: '.formatter.toUpperCase'
                    }"
                    counter="{
                        path: 'UnitsInStock',
                        formatter: '.formatter.multiply'
                    }"
                    press="onPressListItem"
                /> -->
            </items>
        </List>
    </Page>
</mvc:View>
